# Origin of the Kaneo instance, with or without /api.
KANEO_API_URL=
# Kaneo API key, sent as a Bearer token. Never commit a value.
KANEO_API_KEY=
# Optional: slug of the project holding the sprint cards. Empty when the boards run no sprints.
KANEO_SPRINT_PROJECT=
# Contract tests only: a card to read on the live instance, like ABC-12.
KANEO_CONTRACT_TICKET=
